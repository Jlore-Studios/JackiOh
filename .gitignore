node_modules/
dist/
coverage/
ai-gate-shards/
.vite/
*.log
.DS_Store

# Secrets. `crates/server/.env` holds SUPABASE_SECRET_KEY (bypasses every RLS policy) and
# CODE_PEPPER (the invite-code HMAC pepper), so it must never be committed. The example file
# carries placeholders only and is checked in on purpose.
.env
.env.*
!.env.example
# The production and staging web builds' public settings: VITE_ values only, all of them shipped to
# every browser (apps/web/src/net/env-production.test.ts holds both to that).
!apps/web/.env.production
!apps/web/.env.staging
# The dev dashboard's two builds (#3074): its Supabase project's URL and publishable key, the same as the
# web's (apps/admin/src/env.test.ts holds them to that).
!apps/admin/.env.production
!apps/admin/.env.staging

# Local scratch.
*.tmp.*
__pycache__/

# Agent worktrees (git worktrees created by the Agent tool for isolated parallel work).
.claude/worktrees/

# Claude Code session transcripts. One was committed at the repo root (1.5 MB) and pushed; it is
# not source, it bloats every clone, and a transcript is exactly the kind of file a secret ends up
# in by accident.
*local-command-caveat*.txt

# This repo is pnpm (pnpm-lock.yaml, packageManager pnpm@11.3.0) and both deploys install with
# --frozen-lockfile. An npm lockfile arrived once via a PR; ignored so it cannot drift back in and
# be mistaken for the real one.
package-lock.json
.wrangler/

# The v0.3.0 Rust workspace (docs/v0.3.0/SURFACE.md §1): cargo's build output, the downloaded
# wasm-bindgen-cli (scripts/build-wasm.sh) and the generated WASM package the web client loads.
target/
.cache/
apps/web/src/wasm/pkg/

# Mutation testing (scripts/mutants.sh, which writes target/mutants/): cargo-mutants' report when it
# runs on its own, and Stryker's temporary files, log and report when it does.
mutants.out/
mutants.out.old/
.stryker-tmp/
stryker.log
reports/mutation/

# Terraform (infra/README.md): the providers `init` downloads, the state (it holds whatever the
# providers read, and lives in the remote backend) and variable files. .terraform.lock.hcl is
# committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# The notebooks' project (analysis/README.md): its virtual environment, the record files it is pointed at
# and Jupyter's autosaves.
analysis/.venv/
analysis/data/
.ipynb_checkpoints/
