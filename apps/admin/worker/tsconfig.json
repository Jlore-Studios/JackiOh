{
  // The Worker runs on Cloudflare's runtime, whose globals are @cloudflare/workers-types', not the DOM's.
  // Its tests (vitest project `admin`, node environment) need only the fetch API both runtimes share.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["."]
}
