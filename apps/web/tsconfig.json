{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // The `@jackioh/*` specifiers the client imports, resolved to its own wire layer as
    // vite.config.ts's `jackiohAliases` resolves them (docs/v0.3.0/SURFACE.md §10.4). The engine,
    // the AI and the validator are the Rust ones behind `src/wasm/` (whose `pkg/` is generated by
    // scripts/build-wasm.sh), and `src/wire/generated/` is ts-rs's output.
    "paths": {
      "@jackioh/shared": ["./src/wire/index.ts"],
      "@jackioh/engine": ["./src/wire/engine.ts"],
      "@jackioh/engine/config": ["./src/wire/engineConfig.ts"],
      "@jackioh/validator": ["./src/wire/validator.ts"],
      "@jackioh/cards": ["./src/wire/cards.ts"],
      "@jackioh/cards/catalog.json": ["../../crates/cards/catalog.json"],
      "@jackioh/cards/flavour.json": ["../../crates/cards/flavour.json"],
      "@jackioh/cards/chinese.json": ["../../crates/cards/chinese.json"],
      "@jackioh/cards/chinese-terms.json": ["../../crates/cards/chinese-terms.json"],
      "@jackioh/ai": ["./src/wire/ai.ts"],
      "@jackioh/ai/config": ["./src/wire/ai.ts"],
      "@jackioh/server-config": ["./src/wire/serverConfig.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
