# JackiOh client environment. Copy to apps/web/.env and fill in.
#
# On Vercel these are Project Settings -> Environment Variables instead: Vite reads a VITE_ value
# at BUILD time and compiles it into the bundle, so both must be set before the build runs, not
# at request time.
#
# EVERY VARIABLE HERE IS PUBLIC. Vite compiles VITE_-prefixed values into the browser bundle,
# so anyone who loads the page can read them. The server-only half of the contract lives in
# crates/server/.env.example, and the two lists are disjoint by design (`PUBLIC_ENV_VARS` and
# `SERVER_ONLY_ENV_VARS` in crates/server/src/env.rs).

# Dashboard -> Project Settings -> Data API -> Project URL. Same value as the server's SUPABASE_URL.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...).
# The browser authenticates against Supabase Auth directly with this key (SPEC §9.2); the server
# only verifies the token that comes back. NEVER put SUPABASE_SECRET_KEY here: it bypasses every
# RLS policy, and this file ships to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional. Default to the port the server (crates/server) listens on, so local dev needs neither.
# VITE_SERVER_HTTP_URL=http://localhost:8787
# VITE_SERVER_WS_URL=ws://localhost:8787/ws/match

# Optional (R666). The OAuth providers the sign-in screen offers, comma-separated, as Supabase names
# them: apple, azure (Microsoft), discord, facebook, github, gitlab, google, twitch. Unset, the screen
# offers none. Name a provider here ONLY once it is enabled under Dashboard -> Authentication ->
# Sign In / Providers (docs/architecture.md, bring-up step 2): a button for a provider the project
# has not enabled fails at the provider. Names only: a provider's client id and secret go in the
# Supabase dashboard, never here.
# VITE_AUTH_OAUTH_PROVIDERS=google,github
