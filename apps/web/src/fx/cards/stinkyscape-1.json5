  "stinkyscape-004-3": "none: its extra turn moves nothing on the board; no motif reads modifierChanged", // Event Horizon
  "stinkyscape-004-4": { cast: { motif: "snap" } }, // Last Word
  "stinkyscape-004-5": { cast: { motif: "bind" } }, // 1v1 Final Destination
