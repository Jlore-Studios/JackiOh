// R2784000: the signature animation of every Meditative+ card (docs/polish/9-card-animations.md).
// One line per catalog card, tokens included, in catalog order, its name in a comment after it
// (tables.test.ts holds the file to the catalog). An entry is one of:
//   "none: <reason>"                        the card's event rows alone ("none: pending" until its set's pass);
//   { bespoke: "<recipe>" }                 its own recipe (fx/cards/bespoke.ts), drawn in fx/cards/<set>/;
//   { setPiece: "<key>" }                   a board clear's set piece (fx/setPieces.ts), held for one beat (R2800000);
//   { <hook>: { motif, palette?, row? } }   a shared motif (fx/motifs/names.ts) on a hook.
//   { aura: { look, palette?, scope } }     a standing look while it holds, alone or beside hooks (fx/aura/looks.ts, R2787000).
// Hooks: `cast` (a non-Unit's play) and `cry` (a Unit's) play as the card resolves; `death`, `trigger` and
// `activate` are accepted and wait for #2783. `palette` is a flavor's look (the card's own flavor by
// default); `row` is "replace" (the default: the motif draws the numbers in place of the event's own
// recipe) or "keep" (it plays over that recipe).
{
  "meditativeplus-001": { cast: { motif: "deal", palette: "Nerd/ink" } }, // Bob's Plan
  "meditativeplus-001-1": { cast: { motif: "deal" } }, // Base Camp
  "meditativeplus-001-2": { cast: { motif: "deal" } }, // Spa Day
  "meditativeplus-001-3": { cast: { motif: "vanish", palette: "Hustle/cash" } }, // Garage Sale
  "meditativeplus-001-4": { cast: { motif: "bless", palette: "Physical/sport" } }, // Leg Day
  "meditativeplus-001-5": "none: no motif reads starscapeTravelled (its map draws the journey)", // Star Chart
  "meditativeplus-002": { cast: { motif: "deal", palette: "Tech/hologram" } }, // NA Tech
  "meditativeplus-003": { cast: { motif: "flight" } }, // Wondrous Wand
  "meditativeplus-004": { cast: { motif: "seal" } }, // Jlockeed's Supply Drop
  "meditativeplus-005": { cast: { motif: "nova" } }, // Spirit Lash
  "meditativeplus-006": { cast: { motif: "seal", palette: "Dark/blood" } }, // Bloodbloom
  "meditativeplus-007": "none: vanilla", // Life Mage
  "meditativeplus-008": "none: vanilla", // Arch Mage
  "meditativeplus-009": { cast: { motif: "deal" }, aura: { look: "arcane", scope: "board" } }, // Magic Amplifier
  "meditativeplus-010": { cry: { motif: "tether", palette: "Hustle/cash" } }, // Medina Grifter
  "meditativeplus-011": { activate: { motif: "seal" } }, // Living Mana Potion
  "meditativeplus-012": { activate: { motif: "seal" } }, // Living Armor Potion
  "meditativeplus-013": { activate: { motif: "mend" } }, // Living Health Potion
  "meditativeplus-014": { cast: { motif: "deal" } }, // Potion Pouch
  "meditativeplus-015": { cast: { motif: "deal", palette: "Nerd/ink" } }, // Book of Potions
  "meditativeplus-016": { cry: { motif: "deal" }, death: { motif: "deal" } }, // Jazakus
  "meditativeplus-016-1": { cry: { motif: "deal" } }, // Jazakus Prime
  "meditativeplus-017": { cast: { motif: "bolt" } }, // Dogpile
  "meditativeplus-018": { cast: { motif: "mana", palette: "Tech/hologram" } }, // Cognitive Offloading
  "meditativeplus-019": { cast: { motif: "tether", palette: "Dark/shadow" } }, // Grubby Gloves
  "meditativeplus-020": { cast: { motif: "conjure" } }, // KY's Competition
  "meditativeplus-020-1": "none: unseen (no census game summoned it)", // Lil' Kenny
  "meditativeplus-021": { bespoke: "harmonyWave" }, // Harmony Spirit
  "meditativeplus-022": { cast: { motif: "bless" }, aura: { look: "holy", scope: "side" } }, // Mountaintop Garden
  "meditativeplus-023": { cast: { motif: "deal" } }, // Enormous Elderberry
  "meditativeplus-024": { cry: { motif: "deal" } }, // Bob, Wisconsin's Strongest Soldier
  "meditativeplus-025": { cast: { motif: "deal", palette: "Nerd/pixel" } }, // KY's Intuition
  "meditativeplus-026": { cast: { motif: "deal", palette: "Nerd/pixel" } }, // Scratch Pad
}
