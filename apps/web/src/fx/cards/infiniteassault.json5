// R2784000: the signature animation of every Infinite Assault card (docs/polish/9-card-animations.md).
// One line per catalog card, tokens included, in catalog order, its name in a comment after it
// (tables.test.ts holds the file to the catalog). An entry is one of:
//   "none: <reason>"                        the card's event rows alone ("none: pending" until its set's pass);
//   { bespoke: "<recipe>" }                 its own recipe (fx/cards/bespoke.ts), drawn in fx/cards/<set>/;
//   { setPiece: "<key>" }                   a board clear's set piece (fx/setPieces.ts), held for one beat (R2800000);
//   { <hook>: { motif, palette?, row? } }   a shared motif (fx/motifs/names.ts) on a hook.
//   { aura: { look, palette?, scope } }     a standing look while it holds, alone or beside hooks (fx/aura/looks.ts, R2787000),
//                                           or beside a bespoke; a Unit's on its own `tile` (R3400000).
//   + entrance: "<key>"                     beside any entry but "none", or alone: a Unit's or a Field Spell's entrance (fx/entrances.ts, R3332000);
//   + takeover: "<look>", signature: true   a Mythic's own takeover look (fx/takeover.ts); a Legendary's or Mythic's signature (R3332000).
// Hooks: `cast` (a non-Unit's play) and `cry` (a Unit's) play as the card resolves; `death`, `trigger` and
// `activate` play from the hook's own `hookResolving` marker (R2797000). `palette` is a flavor's look (the
// card's own flavor by default); `row` is "replace" (the default: the motif draws the numbers in place of
// the event's own recipe) or "keep" (it plays over that recipe). Written with the set's first part (issue
// #4577) from the shipped sets' choices for cards that do the same: shared motifs and looks only, no recipe
// or set piece of its own, every Legendary and Mythic on signature.test.ts's SIGNATURE_PENDING until its
// set's signature pass. The set is an army of generated cards, so its looks are Tech's: glitch for the cards
// it writes, rocket for the drones it launches, laser for the shots it fires.
{
  "infiniteassault-001": { cry: { motif: "send", palette: "Tech/glitch" } }, // Seed Drone
  "infiniteassault-002": { death: { motif: "send", palette: "Tech/glitch" } }, // Scrap Prototype
  "infiniteassault-003": "none: keywords only", // Assault Trooper
  "infiniteassault-004": { trigger: { motif: "conjure", palette: "Tech/rocket" } }, // Wave Spawner
  "infiniteassault-004-1": "none: token, vanilla", // Drone
  "infiniteassault-005": { cast: { motif: "deal", palette: "Tech/glitch" } }, // Generated Filler
  "infiniteassault-006": { cast: { motif: "bless" } }, // Hotfix
  "infiniteassault-007": { cast: { motif: "conjure", palette: "Tech/rocket" } }, // Bulk Order
  "infiniteassault-008": { cast: { motif: "bolt", palette: "Tech/laser" } }, // Firing Solution
  "infiniteassault-009": { cry: { motif: "bless" } }, // Heavy Lifter Mk.II
  "infiniteassault-010": { death: { motif: "conjure", palette: "Tech/rocket" } }, // Assault Carrier
  "infiniteassault-010-1": "none: token, vanilla", // Drone Escort
  "infiniteassault-011": { trigger: { motif: "barrage", palette: "Tech/laser" } }, // Quickgen Turret
  "infiniteassault-012": { cast: { motif: "transmute", palette: "Tech/glitch" } }, // Recompile
  "infiniteassault-013": { cast: { motif: "send", palette: "Tech/glitch" } }, // Training Run
  "infiniteassault-014": { cast: { motif: "snap", palette: "Tech/glitch" } }, // Overflow Error
  "infiniteassault-015": { cast: { motif: "conjure" }, trigger: { motif: "conjure", palette: "Tech/rocket" }, aura: { look: "steam", palette: "Tech/rocket", scope: "zone" } }, // Drone Foundry
  "infiniteassault-016": { cast: { motif: "bless" } }, // Benchmark Run
  "infiniteassault-017": { death: { motif: "nova", palette: "Tech/rocket" } }, // Cluster Drone
  "infiniteassault-018": "none: its Aura is a standing cost cut, with no moment to draw", // Prompt Engineer
  "infiniteassault-019": { cast: { motif: "flight" } }, // Infinite Scroll
  "infiniteassault-020": { cast: { motif: "deal", palette: "Tech/glitch" } }, // Synthetic Data
  "infiniteassault-021": { cast: { motif: "conjure" }, trigger: { motif: "conjure", palette: "Tech/glitch" }, aura: { look: "glitch", palette: "Tech/glitch", scope: "zone" } }, // Endless Production Line
  "infiniteassault-022": "none: its Aura is a standing stat bonus, with no moment to draw", // Assault Mainframe
  "infiniteassault-023": { trigger: { motif: "send", palette: "Tech/glitch" } }, // The Generator
  "infiniteassault-024": { cast: { motif: "conjure", palette: "Tech/rocket" } }, // Mass Deployment
}
