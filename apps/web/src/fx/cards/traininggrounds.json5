// R2784000: the signature animation of every Training Grounds card (docs/polish/9-card-animations.md).
// One line per catalog card, tokens included, in catalog order, its name in a comment after it
// (tables.test.ts holds the file to the catalog). An entry is one of:
//   "none: <reason>"                        the card's event rows alone ("none: pending" until its set's pass);
//   { bespoke: "<recipe>" }                 its own recipe (fx/cards/bespoke.ts), drawn in fx/cards/<set>/;
//   { setPiece: "<key>" }                   a board clear's set piece (fx/setPieces.ts), held for one beat (R2800000);
//   { <hook>: { motif, palette?, row? } }   a shared motif (fx/motifs/names.ts) on a hook.
//   { aura: { look, palette?, scope } }     a standing look while it holds, alone or beside hooks (fx/aura/looks.ts, R2787000).
// Hooks: `cast` (a non-Unit's play) and `cry` (a Unit's) play as the card resolves; `death`, `trigger` and
// `activate` are accepted and wait for #2783. `palette` is a flavor's look (the card's own flavor by
// default); `row` is "replace" (the default: the motif draws the numbers in place of the event's own
// recipe) or "keep" (it plays over that recipe).
{
  "traininggrounds-001": "none: vanilla", // Spikey Steven
  "traininggrounds-002": { cry: { motif: "bless", palette: "Physical/sport" } }, // Personal Trainer
  "traininggrounds-003": "none: its Aura is a standing Attack bonus, with no moment to draw", // Group leader
  "traininggrounds-004": "none: vanilla", // Boulder Fist Ogre
  "traininggrounds-005": { cry: { motif: "bless" } }, // Midlane Menace
  "traininggrounds-006": "none: vanilla", // Chosen by the Sun
  "traininggrounds-007": "none: vanilla", // Chosen by the Moon
  "traininggrounds-008": "none: vanilla", // Clobberer
  "traininggrounds-009": { trigger: { motif: "bless" } }, // Ravager
  "traininggrounds-010": { cast: { motif: "volley" } }, // Fan of Knives
  "traininggrounds-011": { cast: { motif: "bolt" } }, // Thwomp
  "traininggrounds-012": { cast: { motif: "bless", palette: "Physical/steel" } }, // Fortify
  "traininggrounds-013": { cast: { motif: "volley" } }, // Explosive Runes
  "traininggrounds-014": { cast: { motif: "bolt" } }, // Explosive Trap
  "traininggrounds-015": { cast: { motif: "conjure", palette: "Physical/wind" } }, // In a hurry
  "traininggrounds-016": { bespoke: "celestialCall" }, // Celestial Caller
  "traininggrounds-017": { cry: { motif: "nova" } }, // Flaming Felinor
  "traininggrounds-018": { trigger: { motif: "bolt", palette: "Physical/blade" } }, // Knife Juggler
  "traininggrounds-019": { cast: { motif: "conjure" }, trigger: { motif: "flight" }, aura: { look: "bloom", scope: "zone" } }, // Extra Rations
  "traininggrounds-020": { cast: { motif: "conjure" }, trigger: { motif: "send" }, aura: { look: "holy", scope: "zone" } }, // Recruitment Posters
  "traininggrounds-021": "none: its Aura is a standing Attack bonus, with no moment to draw", // Flame Tongue Totem
  "traininggrounds-022": { cry: { motif: "bless", palette: "Beast/felinor" } }, // Right-Hand Felinor
  "traininggrounds-023": { cry: { motif: "conjure", palette: "Beast/felinor" } }, // Quadrupling Felinors
  "traininggrounds-024": { cast: { motif: "tithe" } }, // Goliath Situation
