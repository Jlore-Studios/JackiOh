    "sapi-librarian": { backend: "sapi", voice: "Microsoft Zira Desktop", rate: -5, semitones: -2, filter: "aecho=0.8:0.5:35:0.2", web: { pitch: 0.9, rate: 0.9 } },
    "sapi-mystic": { backend: "sapi", voice: "Microsoft Zira Desktop", rate: -10, semitones: -1, filter: "aecho=0.8:0.6:80:0.3,vibrato=f=5:d=0.1", web: { pitch: 0.9, rate: 0.9 } },
    "sapi-rasp": { backend: "sapi", voice: "Microsoft David Desktop", rate: -10, semitones: -4, filter: "highpass=f=250,aecho=0.6:0.4:20:0.3", web: { pitch: 0.6, rate: 0.9 } },
    "sapi-synth": { backend: "sapi", voice: "Microsoft Zira Desktop", rate: 5, semitones: 0, filter: "acrusher=bits=8:mix=0.35,flanger=delay=2:depth=2", web: { pitch: 1, rate: 1 } },
    "sapi-synth-deep": { backend: "sapi", voice: "Microsoft David Desktop", rate: 0, semitones: -2, filter: "acrusher=bits=8:mix=0.3,flanger=delay=3:depth=2", web: { pitch: 0.6, rate: 1 } },
