    bubbles: { say: "Bubbles", rate: 180, pbas: 45, pmod: 30, web: { pitch: 1, rate: 1 }, gain: 1.55 },
    cat: { say: "Kathy", rate: 210, pbas: 70, pmod: 70, web: { pitch: 1.8, rate: 1.2 }, gain: 0.83 },
    crone: { say: "Grandma (English (US))", rate: 170, pbas: 50, pmod: 40, web: { pitch: 1.1, rate: 0.9 } },
