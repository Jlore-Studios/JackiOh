    diva: { say: "Samantha", rate: 185, pbas: 55, pmod: 60, web: { pitch: 1.2, rate: 1 }, gain: 0.61 },
    elder: { say: "Grandpa (English (UK))", rate: 165, pbas: 35, pmod: 30, web: { pitch: 0.8, rate: 0.9 }, gain: 1.56 },
