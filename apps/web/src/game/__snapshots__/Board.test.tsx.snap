        class="control control-end-turn button-primary"
        data-legal="false"
        data-testid="end-turn"
        data-turn-state="locked"
        disabled=""
        type="button"
      >
        End turn
      </button>
    </div>
    <button
      aria-disabled="true"
      class="control control-offer-draw"
      data-legal="false"
      data-testid="offer-draw"
      disabled=""
      type="button"
    >
      Offer draw
    </button>
    <button
      aria-disabled="true"
      class="control control-concede"
      data-legal="false"
      data-testid="concede"
      disabled=""
      type="button"
    >
      Concede
    </button>
    <button
      aria-expanded="false"
      aria-label="Show the game log"
      class="log-toggle"
      data-testid="log-toggle"
      title="Game log"
      type="button"
    >
      <span
        aria-hidden="true"
        class="log-toggle-icon"
      />
    </button>
    <button
      aria-label="Mute sound"
      aria-pressed="false"
      class="audio-toggle audio-toggle--bar"
      data-testid="audio-toggle"
      title="Mute sound"
      type="button"
    >
      <svg
        aria-hidden="true"
        class="audio-toggle__icon"
        fill="none"
        focusable="false"
        height="22"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="22"
      >
        <path
          d="M4 9h4l5-4v14l-5-4H4z"
          fill="currentColor"
        />
        <path
          d="M16 9.5a3.5 3.5 0 0 1 0 5"
        />
        <path
          d="M18.5 7a7 7 0 0 1 0 10"
        />
      </svg>
    </button>
    <button
      aria-label="EN. Language: English. Switch to 简体中文."
      class="language-button language-button--game"
      data-locale="en"
      data-testid="language-game"
      title="Language"
      type="button"
    >
      <span
        aria-hidden="true"
        lang="en"
      >
        EN
      </span>
    </button>
    <button
      aria-expanded="false"
      aria-haspopup="dialog"
      aria-label="Settings"
      class="settings-gear settings-gear--game"
      data-testid="settings-open-game"
      title="Settings"
      type="button"
    >
      <span
        aria-hidden="true"
        class="settings-gear__icon"
      >
        <svg
          focusable="false"
          height="20"
          viewBox="0 0 24 24"
          width="20"
        >
          <path
            d="M19.47 10.14 L22.11 10.64 L22.11 13.36 L19.47 13.86 L18.60 15.97 L20.11 18.19 L18.19 20.11 L15.97 18.60 L13.86 19.47 L13.36 22.11 L10.64 22.11 L10.14 19.47 L8.03 18.60 L5.81 20.11 L3.89 18.19 L5.40 15.97 L4.53 13.86 L1.89 13.36 L1.89 10.64 L4.53 10.14 L5.40 8.03 L3.89 5.81 L5.81 3.89 L8.03 5.40 L10.14 4.53 L10.64 1.89 L13.36 1.89 L13.86 4.53 L15.97 5.40 L18.19 3.89 L20.11 5.81 L18.60 8.03 Z M15.30 12.00 A3.3 3.3 0 1 0 8.70 12.00 A3.3 3.3 0 1 0 15.30 12.00 Z"
            fill="currentColor"
            fill-rule="evenodd"
          />
        </svg>
      </span>
    </button>
  </div>
  <ol
    aria-label="Game log"
    class="log"
    data-testid="log"
  />
</div>
`;
