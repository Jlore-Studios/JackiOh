# Cloudflare's copy of vercel.json's `headers`, sent on every response, but for staging's
# `X-Robots-Tag: noindex`, which production must never send (#770).
# apps/web/src/net/cloudflare-config.test.ts holds them equal to vercel.json's otherwise.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://exmjdaswedxhnzmpzqrq.supabase.co https://jackioh-server.onrender.com wss://jackioh-server.onrender.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The web fonts (src/fonts.css): a file's name carries its version, so a browser keeps it a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The bundle, its chunks and the engine's module (Vite's build output): every name carries its content's hash, so a browser keeps it a year (#778).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
