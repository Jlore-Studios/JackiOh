{
  "repo": "jgoetzmann/JackiOh",
  "default_branch": "main",
  "bot_login": "squishy-squooby",
  "bot_user_id": 334289562,
  "operator": "jgoetzmann",
  "timezone": "America/Chicago",
  "identity": {
    "name": "Squishy",
    "title": "Squishy",
    "command": "squishy",
    "label_prefix": "squishy:",
    "branch_prefix": "squishy/",
    "state_branch": "squishy-state",
    "journal_branch": "squishy-journal",
    "usage_branch": "",
    "workflow": "squishy-run.yml",
    "marker": "<!-- jackioh-squishy -->",
    "trust": ".harness/trust.txt",
    "modes": ["oneshot", "split", "split-bot", "fullsend"],
    "others": [
      { "name": "the night bot", "login": "jgoetzmann-bot", "label_prefix": "bot:", "workflow": "bot-night.yml" }
    ]
  },
  "max_turns": { "plan": 200, "build": 600, "fix": 300, "revise": 300, "review": 150, "suggest": 120 },
  "call_timeout_minutes": 300,
  "job_budget_minutes": 330,
  "min_minutes_for_a_call": 25,
  "max_review_cycles": 10,
  "max_self_check_rounds": 3,
  "max_failures": 3,
  "auto_merge": true,
  "merge_method": "squash",
  "ci_workflow": "CI",
  "required_checks": [
    "rust",
    "web",
    "e2e smoke",
    "db",
    "bot selftest"
  ],
  "ci_reruns": 1,
  "suggestions": { "enabled": false, "max_open": 0, "idle_minutes": 30 },
  "quiet": { "enabled": false, "interval_minutes": 10, "max_wait_minutes": 120, "ping_model": "haiku", "partners": [] },
  "forbidden_paths": [
    ".github/",
    ".harness/",
    ".squishy/",
    "bot/",
    ".claude/",
    "!.claude/skills/",
    ".mcp.json",
    ".vscode/",
    ".devcontainer/",
    ".husky/",
    ".gitattributes",
    ".gitmodules",
    ".fullsend/"
  ],
  "review_paths": [
    "pnpm-workspace.yaml",
    ".npmrc",
    ".nvmrc",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "clippy.toml",
    ".cargo/",
    "vitest.*",
    "vite.config.*",
    "eslint.config.*",
    "tsconfig*.json",
    "cypress.config.*",
    "wrangler.jsonc",
    "apps/edge/",
    "apps/web/public/_headers",
    "scripts/promote-production.sh",
    "scripts/vercel-ignore.sh"
  ],
  "migration_paths": ["crates/server/migrations/"],
  "lock_files": ["Cargo.lock", "pnpm-lock.yaml"],
  "decision_wait_hours": 24,
  "decision_assignees": ["jgoetzmann", "MaxGoetzmann"],
  "upload_transcripts": false,
  "resume_sessions": false,
  "hold_minutes": 0,
  "spot_check_every": 0,
  "fullsend_adopt": false,
  "fullsend_send_backs": 0,
  "own_review_run": false,
  "usage_history": false,
  "install": { "run": "rustup toolchain install && pnpm install --frozen-lockfile", "timeout_minutes": 20 },
  "gates": [
    { "name": "rustfmt", "run": "cargo fmt --check", "timeout_minutes": 5 },
    { "name": "catalog", "run": "cargo jackioh catalog check", "timeout_minutes": 20 },
    { "name": "patches", "run": "cargo jackioh patches check", "timeout_minutes": 10 },
    { "name": "rulings", "run": "cargo jackioh spec check", "timeout_minutes": 10 },
    {
      "name": "clippy",
      "run": "cargo clippy --workspace --all-targets -- -D warnings",
      "timeout_minutes": 30,
      "machine": false
    },
    {
      "name": "cargo tests",
      "run": "cargo test --workspace --features jackioh-engine/testkit,jackioh-engine/ts && test -z \"$(git status --porcelain -- apps/web/src/wire)\"",
      "timeout_minutes": 30,
      "machine": false
    },
    {
      "name": "web tests",
      "run": "sh scripts/build-wasm.sh && pnpm exec vitest run --project web --changed origin/main --exclude '**/src/audio/**' --exclude '**/src/fx/**' --exclude '**/src/cards/art/convention.test.ts'",
      "timeout_minutes": 20,
      "machine": false
    }
  ],
  "resolvers": [
    {"path": "spec/INDEX.md", "take": "main"},
    {"path": "crates/engine/tests/golden/games.jsonl", "run": "cargo jackioh golden bless --file crates/engine/tests/golden/games.jsonl", "timeout_minutes": 20}
  ]
}
