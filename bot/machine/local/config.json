{
  "repo": "Jlore-Studios/JackiOh",
  "image": "jackioh-pc-runner:latest",
  "serve": [
    { "label": "jackioh-selfplay-local", "workflows": ["learn.yml", "selfplay.yml"], "standby": true },
    { "label": "jackioh-selfplay-local-gather", "workflows": ["gather.yml"], "ownSlot": true },
    { "label": "night-vm-muse", "workflows": ["bot-night.yml", "triage.yml"], "home": "jackioh-pc-home-muse" },
    { "label": "night-vm-gpt", "workflows": ["bot-night.yml", "triage.yml"], "home": "jackioh-pc-home-gpt", "seccompUnconfined": true },
    { "label": "night-vm-agy", "workflows": ["bot-night.yml", "triage.yml"], "home": "jackioh-pc-home-agy" }
  ],
  "maxJobs": 2,
  "cpuPercentBelow": 50,
  "startCpuPercentBelow": 15,
  "memoryGBBelow": 24,
  "calmSeconds": 60,
  "sampleSeconds": 5,
  "containerCpus": 4,
  "containerMemory": "6g",
  "throttledCpus": 0.5,
  "yieldingContainers": [],
  "heartbeatSeconds": 120
}
