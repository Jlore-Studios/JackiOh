{
  "name": "jackioh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter @jackioh/web build",
    "build:e2e": "pnpm --filter @jackioh/web build:e2e",
    "dev": "pnpm --filter @jackioh/web dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "sh crates/server/tests/db/run.sh",
    "test:deploy": "sh crates/server/tests/deploy/rehearse.sh",
    "test:e2e": "pnpm --filter @jackioh/e2e test:e2e",
    "test:sql": "sh crates/server/tests/sql/run.sh",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p e2e/cypress/component/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "fast-check": "4.10.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
