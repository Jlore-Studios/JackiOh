{
  // The root's own TypeScript, the vitest workspace file. The web and the e2e specs are projects of
  // their own (apps/web/tsconfig.json, e2e/tsconfig.json, e2e/cypress/component/tsconfig.json), which
  // the root `typecheck` runs after this one.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "include": [
    "vitest.config.ts"
  ]
}
