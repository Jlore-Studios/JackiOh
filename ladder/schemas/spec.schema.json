{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JackiOh ladder proposal spec (issue #55)",
  "type": "object",
  "required": ["name", "agent", "files"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "agent": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["rl", "multi_context"] },
        "algorithm": { "enum": ["ppo_masked", "dqn", "mcts_value", "variant"] },
        "algorithm_notes": { "type": "string" },
        "specialists": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "trigger"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "trigger": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "card_on_board": { "type": "string", "minLength": 1 },
                  "own_life_below": { "type": "integer", "minimum": 0 },
                  "card_in_hand": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" }
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opponents": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["champion1", "champion2", "random", "self-play"] }
        },
        "budget_minutes": { "type": "number", "minimum": 0 }
      }
    }
  }
}
