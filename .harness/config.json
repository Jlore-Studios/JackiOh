{
  "repo": "jgoetzmann/JackiOh",
  "default_branch": "main",
  "bot_login": "jgoetzmann-bot",
  "bot_user_id": 324324626,
  "operator": "jgoetzmann",
  "timezone": "America/Chicago",
  "identity": {
    "modes": ["fullsend"],
    "others": [
      {
        "name": "Squishy",
        "login": "squishy-squooby",
        "label_prefix": "squishy:",
        "home": ".squishy",
        "token_env": "SQUISHY_GITHUB_TOKEN",
        "workflow": "squishy-run.yml",
        "marker": "<!-- jackioh-squishy -->"
      }
    ]
  },
  "max_turns": { "plan": 150, "build": 400, "fix": 300, "revise": 300, "review": 100, "suggest": 120 },
  "call_timeout_minutes": 150,
  "job_budget_minutes": 330,
  "min_minutes_for_a_call": 25,
  "max_review_cycles": { "hard": 10, "medium": 3 },
  "max_self_check_rounds": 3,
  "controller": true,
  "max_failures": 3,
  "auto_merge": true,
  "merge_method": "squash",
  "ci_workflow": "CI",
  "required_checks": [
    "rust",
    "web",
    "e2e smoke",
    "db",
    "bot selftest"
  ],
  "ci_reruns": 1,
  "suggestions": {
    "enabled": true,
    "max_open": 10,
    "spare_lanes": 3,
    "idle_minutes": 0,
    "priorities": {
      "fuzz": "low",
      "checks": "low",
      "telemetry": "low",
      "refactor": "low",
      "ai": "low",
      "fairness": "low",
      "security": "medium",
      "polish": "medium",
      "data": "high"
    }
  },
  "quiet": {
    "enabled": true,
    "interval_minutes": 10,
    "max_wait_minutes": 120,
    "ping_model": "haiku",
    "partners": [
      {
        "repo": "jgoetzmann/bright-bots-harness",
        "workflows": {
          "implement.yml": ["Run planned items"],
          "discover.yml": ["Discover and propose"],
          "feedback.yml": ["Sweep keywords", "Reconcile stale"]
        }
      }
    ]
  },
  "forbidden_paths": [
    ".github/",
    ".harness/",
    ".squishy/",
    "bot/",
    ".claude/",
    ".mcp.json",
    ".vscode/",
    ".devcontainer/",
    ".husky/",
    ".gitattributes",
    ".gitmodules"
  ],
  "review_paths": [
    "pnpm-workspace.yaml",
    ".npmrc",
    ".nvmrc",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "clippy.toml",
    ".cargo/",
    "vitest.*",
    "vite.config.*",
    "eslint.config.*",
    "tsconfig*.json",
    "cypress.config.*",
    "wrangler.jsonc",
    "apps/edge/",
    "apps/web/public/_headers",
    "scripts/promote-production.sh",
    "scripts/promote-staging.sh",
    "scripts/vercel-ignore.sh"
  ],
  "migration_paths": ["crates/server/migrations/"],
  "lock_files": ["Cargo.lock", "pnpm-lock.yaml"],
  "decision_wait_hours": 24,
  "decision_assignees": ["jgoetzmann", "MaxGoetzmann"],
  "upload_transcripts": false,
  "resume_sessions": true,
  "hold_minutes": 120,
  "hold_exempt": ["muse"],
  "spot_check_every": 5,
  "fullsend_adopt": true,
  "fullsend_send_backs": 1,
  "own_review_run": true,
  "own_review_reserve_minutes": 30,
  "usage_history": true,
  "install": { "run": "rustup toolchain install && pnpm install --frozen-lockfile", "timeout_minutes": 20 },
  "gates": [
    { "name": "rustfmt", "run": "cargo fmt --check", "timeout_minutes": 5 },
    { "name": "catalog", "run": "cargo jackioh catalog check", "timeout_minutes": 20 },
    { "name": "patches", "run": "cargo jackioh patches check", "timeout_minutes": 10 },
    { "name": "rulings", "run": "cargo jackioh spec check", "timeout_minutes": 10 },
    {
      "name": "clippy",
      "run": "cargo clippy --workspace --all-targets -- -D warnings",
      "timeout_minutes": 30,
      "machine": false
    },
    {
      "name": "cargo tests",
      "run": "cargo test --workspace --features jackioh-engine/testkit,jackioh-engine/ts && test -z \"$(git status --porcelain -- apps/web/src/wire)\"",
      "timeout_minutes": 30,
      "machine": false
    },
    {
      "name": "web tests",
      "run": "sh scripts/build-wasm.sh && pnpm exec vitest run --project web --changed origin/main --exclude '**/src/audio/**' --exclude '**/src/fx/**' --exclude '**/src/cards/art/convention.test.ts'",
      "timeout_minutes": 20,
      "machine": false
    }
  ],
  "resolvers": [
    {"path": "spec/INDEX.md", "take": "main"},
    {"path": "crates/engine/tests/golden/games.jsonl", "run": "cargo jackioh golden bless --file crates/engine/tests/golden/games.jsonl", "timeout_minutes": 20}
  ]
}
