{
  "max_parallel": 10,
  "machine_parallel": 6,
  "priority": ["claude-3", "claude-1", "claude-4", "agy", "muse", "gpt", "claude-2", "devin"],
  "tiers": {
    "weak": [
      { "model": "sonnet", "note": "Claude Sonnet, on claude-3 and claude-1 only." },
      { "model": "swe-2-max", "note": "Devin (SWE-2): the last resort. Its builds check themselves before any review." }
    ],
    "medium": [
      { "model": "gemini-3.8-flash-high", "note": "Google through agy." },
      { "model": "muse-spark-1.3-contributor", "note": "Meta through Muse." },
      { "model": "gpt-5.6-terra", "note": "ChatGPT through Codex." }
    ],
    "strong": [
      { "model": "opus", "note": "Claude Opus, on every Claude account." }
    ]
  },
  "providers": {
    "claude-1": {
      "note": "The Claude subscription the bot has always used; shared with its owner and bright-bots-harness, so it waits for quiet. Second in the usage order: Opus for strong roles, Sonnet for weak-tier builds.",
      "enabled": true,
      "cli": "claude",
      "family": "claude",
      "model": "opus",
      "effort": "xhigh",
      "tier": "strong",
      "extra_models": [{ "model": "sonnet", "effort": "xhigh", "tier": "weak" }],
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN",
      "runs_on": "ubuntu-latest",
      "schedule": { "mode": "window", "start": "21:00", "end": "07:00" },
      "off_hours": { "five_hour": 0.4 },
      "limits": { "mode": "caps", "five_hour": 0.98, "seven_day": 0.9 },
      "quiet_check": true
    },
    "claude-2": {
      "note": "A second Claude account, capped at 90% of both its 5-hour session and its week. Kept back for planning and adversarial review on Opus: after the medium models in the usage order, and it builds only when no other subscription that may is free, Devin included (build_last). It never builds with Sonnet.",
      "enabled": true,
      "cli": "claude",
      "family": "claude",
      "model": "opus",
      "effort": "xhigh",
      "tier": "strong",
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN_2",
      "runs_on": "ubuntu-latest",
      "schedule": { "mode": "always" },
      "limits": { "mode": "caps", "five_hour": 0.9, "seven_day": 0.9 },
      "build_last": true,
      "quiet_check": false
    },
    "claude-3": {
      "note": "A third Claude account, the bot's own: any hour, no caps. First in the usage order: Opus for strong roles, Sonnet for weak-tier builds.",
      "enabled": true,
      "cli": "claude",
      "family": "claude",
      "model": "opus",
      "effort": "xhigh",
      "tier": "strong",
      "extra_models": [{ "model": "sonnet", "effort": "xhigh", "tier": "weak" }],
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN_3",
      "runs_on": "ubuntu-latest",
      "schedule": { "mode": "always" },
      "limits": { "mode": "none" },
      "quiet_check": false
    },
    "claude-4": {
      "enabled": true,
      "cli": "claude",
      "family": "claude",
      "model": "opus",
      "effort": "xhigh",
      "tier": "strong",
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN_4",
      "runs_on": "ubuntu-latest",
      "schedule": { "mode": "window", "start": "21:00", "end": "07:00" },
      "limits": { "mode": "caps", "five_hour": 0.98, "seven_day": 0.9 },
      "quiet_check": false
    },
    "gpt": {
      "note": "ChatGPT through the Codex CLI, logged in on the machine as agent-gpt (`codex login`).",
      "enabled": true,
      "cli": "codex",
      "family": "gpt",
      "model": "gpt-5.6-terra",
      "effort": "xhigh",
      "tier": "medium",
      "login": "machine",
      "runs_on": "night-vm-gpt",
      "schedule": { "mode": "always" },
      "limits": { "mode": "none" },
      "quiet_check": false
    },
    "agy": {
      "note": "Google's Antigravity CLI, logged in on the machine as agent-agy. Gemini 3.8 Flash (High); `agy models` lists the names, each carrying its effort.",
      "enabled": true,
      "cli": "agy",
      "family": "gemini",
      "model": "gemini-3.8-flash-high",
      "effort": "high",
      "tier": "medium",
      "login": "machine",
      "runs_on": "night-vm-agy",
      "schedule": { "mode": "always" },
      "limits": { "mode": "none" },
      "quiet_check": false
    },
    "devin": {
      "note": "Cognition's Devin CLI, logged in on the machine as agent-devin (`devin auth login --force-manual-token-flow`). SWE-2, its effort in the name; `devin models list` names the models.",
      "enabled": true,
      "cli": "devin",
      "family": "cognition",
      "model": "swe-2-max",
      "effort": "",
      "tier": "weak",
      "self_check": true,
      "login": "machine",
      "runs_on": "night-vm-devin",
      "lanes": 6,
      "off_from": "2026-10-15",
      "off_reason": "SWE-2 is free on Devin's CLI only through 2026-10-16 (devin.ai/pricing). After that it draws on the Devin plan's daily and weekly allowance, at 6x (medium) to 12x (max) credits, so Devin needs a new model, caps, or to stay off.",
      "schedule": { "mode": "always" },
      "limits": { "mode": "none" },
      "quiet_check": false
    },
    "muse": {
      "note": "Meta's Muse Code CLI, logged in on the machine as agent-muse (`muse login`).",
      "enabled": true,
      "cli": "muse",
      "family": "muse",
      "model": "muse-spark-1.3-contributor",
      "effort": "xhigh",
      "tier": "medium",
      "login": "machine",
      "runs_on": "night-vm-muse",
      "schedule": { "mode": "always" },
      "limits": { "mode": "none" },
      "quiet_check": false
    }
  }
}
