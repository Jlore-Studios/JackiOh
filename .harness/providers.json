{
  "max_parallel": 3,
  "difficult_label": "difficult",
  "priority": ["claude-1", "claude-2", "claude-3", "claude-4", "devin", "gpt", "agy", "muse"],
  "providers": {
    "claude-1": {
      "note": "The Claude subscription the bot has always used; shared with its owner and bright-bots-harness, so it waits for quiet.",
      "enabled": true,
      "cli": "claude",
      "family": "claude-opus",
      "model": "opus",
      "effort": "xhigh",
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN",
      "runs_on": "night-vm-claude-1",
      "schedule": { "mode": "window", "start": "21:00", "end": "07:00" },
      "limits": { "mode": "caps", "five_hour": 0.98, "seven_day": 0.9 },
      "self_review": true,
      "difficult": true,
      "quiet_check": true
    },
    "claude-2": {
      "note": "A second Claude account. Paste its `claude setup-token` into the secret to turn it on. Any hour, capped at 90% of both its 5-hour session and its week.",
      "enabled": true,
      "cli": "claude",
      "family": "claude-opus",
      "model": "opus",
      "effort": "xhigh",
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN_2",
      "runs_on": "night-vm-claude-2",
      "schedule": { "mode": "always" },
      "limits": { "mode": "caps", "five_hour": 0.9, "seven_day": 0.9 },
      "self_review": true,
      "difficult": true,
      "quiet_check": false
    },
    "claude-3": {
      "note": "A third Claude account, the bot's own: any hour, no caps. It works until Claude refuses, then waits for that limit to reset.",
      "enabled": true,
      "cli": "claude",
      "family": "claude-opus",
      "model": "opus",
      "effort": "xhigh",
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN_3",
      "runs_on": "night-vm-claude-3",
      "schedule": { "mode": "always" },
      "limits": { "mode": "none" },
      "self_review": true,
      "difficult": true,
      "quiet_check": false
    },
    "claude-4": {
      "enabled": true,
      "cli": "claude",
      "family": "claude-opus",
      "model": "opus",
      "effort": "xhigh",
      "login": "secret",
      "secret": "CLAUDE_CODE_OAUTH_TOKEN_4",
      "runs_on": "night-vm-claude-4",
      "schedule": { "mode": "window", "start": "21:00", "end": "07:00" },
      "limits": { "mode": "caps", "five_hour": 0.98, "seven_day": 0.9 },
      "self_review": true,
      "difficult": true,
      "quiet_check": false
    },
    "gpt": {
      "note": "ChatGPT through the Codex CLI, logged in on the machine as agent-gpt (`codex login`).",
      "enabled": true,
      "cli": "codex",
      "family": "gpt",
      "model": "gpt-5.6-terra",
      "effort": "xhigh",
      "login": "machine",
      "runs_on": "night-vm-gpt",
      "schedule": { "mode": "always" },
      "limits": { "mode": "none" },
      "self_review": false,
      "difficult": false,
      "quiet_check": false
    },
    "agy": {
      "note": "Google's Antigravity CLI, logged in on the machine as agent-agy. Gemini 3.8 Flash (High); `agy models` lists the names, each carrying its effort.",
