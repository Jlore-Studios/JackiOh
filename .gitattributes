# Mergiraf, a syntax-aware merge driver, for the code and config files git's line merge conflicts on
# needlessly (#2948; bot/go/internal/resolve/mergiraf.go). Git runs a driver only where
# `merge.mergiraf.driver` is configured: the night bot's work job registers the pinned release in
# each worktree it merges `main` into, and a clone without it (a person's) merges these files with
# git's own text merge, as before.
*.ts merge=mergiraf
*.tsx merge=mergiraf
*.js merge=mergiraf
*.mjs merge=mergiraf
*.cjs merge=mergiraf
*.json merge=mergiraf
*.yml merge=mergiraf
*.yaml merge=mergiraf

# Lockfiles and generated files keep git's own merge: each is regenerated by its tool, never merged
# by hand or by structure.
pnpm-lock.yaml !merge
package-lock.json !merge
apps/web/src/wire/generated/** !merge
apps/web/src/wire/engineConfig.ts !merge
apps/web/src/wire/serverConfig.ts !merge
crates/cards/patches/** !merge
crates/ai/generation.json !merge
crates/engine/tests/golden/** !merge
